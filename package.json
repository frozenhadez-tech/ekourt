{
  "name": "e-kourt",
  "private": true,
  "version": "1.0.0",
  "description": "E-Kourt Pickleball Court POS & Management System",
  "type": "module",
  "scripts": {
    "setup": "tsx server/setup.ts",
    "dev": "concurrently -n api,web -c red,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && npm run build:api && vite build",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --packages=external --target=node20 --log-level=warning --outfile=api/index.js",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "test:api": "tsx tests/workflow.test.ts",
    "test:smoke": "tsx tests/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "^5.108.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.78.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tsx": "^4.23.15",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.14.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
