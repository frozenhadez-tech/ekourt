# Copy to .env (or run `npm run setup`, which generates the secrets for you).
# Never commit real values. Nothing in this file is ever sent to the browser.

# --- Neon Postgres ---------------------------------------------------------
# `neon env pull` / `neon deploy` writes these into .env.local for you.
# Pooled connection string (host contains "-pooler") for the running app:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection string, used for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Auth ---------------------------------------------------------------------
# At least 32 random characters. `npm run setup` generates one.
JWT_SECRET=
SESSION_HOURS=12

# First Super Admin, created on first start when the employees table is empty.
ADMIN_EMAIL=admin@ekourt.local
ADMIN_PASSWORD=

# --- Server --------------------------------------------------------------------
PORT=4000
